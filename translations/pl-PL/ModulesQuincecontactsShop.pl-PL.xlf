<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en-US" target-language="pl-PL" datatype="plaintext" original="ModulesQuincecontactsShop">
    <body>

      <!-- Komunikaty formularza -->
      <trans-unit id="quince.contacts.shop.blad.puste">
        <source>Fill in the email and the message.</source>
        <target>Wpisz adres e-mail i wiadomość.</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.blad.email">
        <source>This is not a valid email address.</source>
        <target>To nie jest poprawny adres e-mail.</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.blad.wysylka">
        <source>The message could not be sent. Please try again in a moment.</source>
        <target>Nie udało się wysłać wiadomości. Spróbuj ponownie za chwilę.</target>
      </trans-unit>

      <!-- Przycisk na karcie produktu i panel boczny -->
      <trans-unit id="quince.contacts.shop.przycisk">
        <source>Ask an expert</source>
        <target>Zapytaj specjalistę</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.tytul">
        <source>Need a hand?</source>
        <target>Potrzebujesz pomocy?</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.specjalista">
        <source>Specialist</source>
        <target>Specjalista</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.albo">
        <source>or write to us</source>
        <target>albo napisz do nas</target>
      </trans-unit>

      <!-- Pola formularza -->
      <trans-unit id="quince.contacts.shop.pole.imie">
        <source>Your name</source>
        <target>Imię i nazwisko</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.pole.email">
        <source>Your email address</source>
        <target>Twój adres e-mail</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.pole.wiadomosc">
        <source>Your message</source>
        <target>Twoja wiadomość</target>
      </trans-unit>

      <!-- Po wysłaniu; po „It went to” stoi nazwa osoby i kropka -->
      <trans-unit id="quince.contacts.shop.wyslano">
        <source>The message is on its way</source>
        <target>Wiadomość jest w drodze</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.wyslano.do">
        <source>It went to</source>
        <target>Trafiła do</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.wyslano.odpowiedz">
        <source>The answer comes back to the address you gave.</source>
        <target>Odpowiedź przyjdzie na podany przez Ciebie adres.</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.wyslij">
        <source>Send the message</source>
        <target>Wyślij wiadomość</target>
      </trans-unit>


      <!-- 0.5.0: telefon w formularzu i domyślna treść potwierdzenia -->
      <trans-unit id="quince.contacts.shop.empty">
        <source>Fill in the fields marked with an asterisk.</source>
        <target>Wypełnij pola oznaczone gwiazdką.</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.phone_invalid">
        <source>This is not a valid phone number.</source>
        <target>To nie jest prawidłowy numer telefonu.</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.phone">
        <source>Your phone number</source>
        <target>Twój numer telefonu</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.confirm_subject">
        <source>We have your message</source>
        <target>Mamy Twoją wiadomość</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.confirm_hello">
        <source>Hello {name},</source>
        <target>Dzień dobry, {name},</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.confirm_thanks">
        <source>thank you for your message about &lt;strong&gt;{product_name}&lt;/strong&gt;. We will reply as soon as we can, usually within one business day.</source>
        <target>dziękujemy za wiadomość w sprawie &lt;strong&gt;{product_name}&lt;/strong&gt;. Odpowiemy najszybciej, jak to możliwe, zwykle w ciągu jednego dnia roboczego.</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.confirm_your">
        <source>Your message:</source>
        <target>Twoja wiadomość:</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.confirm_reply">
        <source>We will reply to: {email}, {phone}</source>
        <target>Odpowiemy na: {email}, {phone}</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.confirm_thanks2">
        <source>thank you for your message. We will reply as soon as we can, usually within one business day.</source>
        <target>dziękujemy za wiadomość. Odpowiemy najszybciej, jak to możliwe, zwykle w ciągu jednego dnia roboczego.</target>
      </trans-unit>

      <!-- Bloki maili (MailLayout) -->
      <trans-unit id="quince.contacts.shop.mail.sku">
        <source>SKU</source>
        <target>SKU</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.mail.price">
        <source>Price</source>
        <target>Cena</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.mail.gross">
        <source>gross</source>
        <target>brutto</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.mail.net">
        <source>net</source>
        <target>netto</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.mail.product">
        <source>Product</source>
        <target>Produkt</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.mail.question_about">
        <source>Your question is about</source>
        <target>Pytasz o produkt</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.mail.customer">
        <source>Customer</source>
        <target>Klient</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.mail.name">
        <source>Name</source>
        <target>Imię i nazwisko</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.mail.email">
        <source>Email</source>
        <target>E-mail</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.mail.phone">
        <source>Phone</source>
        <target>Telefon</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.mail.message">
        <source>Message</source>
        <target>Wiadomość</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.mail.your_message">
        <source>Your message</source>
        <target>Twoja wiadomość</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.mail.expert">
        <source>You will hear from</source>
        <target>Odpowie Ci</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.mail.reply_to">
        <source>We will reply to</source>
        <target>Odpowiemy na</target>
      </trans-unit>
      <trans-unit id="quince.contacts.shop.mail.back">
        <source>Back to the product</source>
        <target>Wróć do produktu</target>
      </trans-unit>

    </body>
  </file>
